# Copy to .env.local and fill in. Never commit real values.
# Separate values for local, staging and production (see ARCHITECTURE.md > Environments).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Where email sign-in links send people back to (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify (staging must point at a dev or preview store, never live orders)
# Dev Dashboard app credentials. The server exchanges them for a 24-hour Admin API token
# (client credentials grant). The client secret also verifies webhook HMACs.
SHOPIFY_STORE_DOMAIN=            # e.g. aegis-hub-dev.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_SECRET=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Anthropic (Ask Aegis)
ANTHROPIC_API_KEY=

# Business config (DECISIONS.md #5: member discount is config, not hard-coded)
MEMBER_DISCOUNT_PERCENT=10
